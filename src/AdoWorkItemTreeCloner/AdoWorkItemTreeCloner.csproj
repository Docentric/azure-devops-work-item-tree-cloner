<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AdoWorkItemTreeCloner</AssemblyName>
    <RootNamespace>AdoWorkItemTreeCloner</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001</NoWarn>
    <Version>1.0.0</Version>
    <Product>Azure DevOps Work Item Tree Cloner</Product>
    <Description>Recursively clones an Azure DevOps Parent/Child work item tree.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AdoWorkItemTreeCloner.Core/AdoWorkItemTreeCloner.Core.csproj" />
  </ItemGroup>
</Project>
